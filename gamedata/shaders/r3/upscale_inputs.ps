#include "common.h"

// Temporal upscaler inputs at render size (engine: CRenderTarget::phase_temporal_inputs)
uniform float4 upscale_params; // xy: render size, z: projection _33, w: projection _43

Texture2D s_upscale_mv_in; // SSS motion vectors: xy = current - previous in uv units (jitter excluded)
Texture2D s_upscale_pos_in; // G-buffer position: z = view-space depth, 0 where nothing was drawn (sky)
Texture2D s_upscale_lens; // 3DSS lens mask: r = 1 where the scope z-write pass drew

struct v2p_upscale
{
	float2 Tex0 : TEXCOORD0;
	float4 Color : COLOR;
	float4 HPos : SV_Position;
};

struct upscale_out
{
	float2 mv : SV_Target0; // previous - current position in render pixels
	float depth : SV_Target1; // hardware depth, 0 near .. 1 far
};

bool lens_at(float2 p) { return s_upscale_lens.Load(int3(p, 0)).r > 0.5f; }

// 3DSS lens: it carries the world's vectors below it but moves with the scope tube (weapon bob), so use the
// vector of the HUD pixel just past the lens rim; per direction: doubling march out of the mask, then bisect the rim.
// Cost per lens pixel: <= 8 directions x (10 + 5 mask taps + 1 vector tap), usually the first direction hits.
bool lens_rim_mv(float2 p, out float2 mv)
{
	static const float2 dirs[8] = { float2(1, 0), float2(-1, 0), float2(0, 1), float2(0, -1),
		float2(0.7071f, 0.7071f), float2(-0.7071f, 0.7071f), float2(0.7071f, -0.7071f), float2(-0.7071f, -0.7071f) };
	mv = 0.0f;
	[loop] for (int d = 0; d < 8; d++)
	{
		float inside = 0.0f, r = 2.0f;
		[loop] for (int i = 0; i < 10 && lens_at(p + dirs[d] * r); i++)
		{
			inside = r;
			r *= 2.0f;
		}
		if (lens_at(p + dirs[d] * r))
			continue;
		[unroll] for (int j = 0; j < 5; j++)
		{
			float m = (inside + r) * 0.5f;
			if (lens_at(p + dirs[d] * m)) inside = m; else r = m;
		}
		float4 v = s_upscale_mv_in.Load(int3(p + dirs[d] * (r + 1.0f), 0));
		if (v.z > 0.5f) // HUD flag: the scope tube, not the world seen beside it
		{
			mv = v.xy;
			return true;
		}
	}
	return false;
}

upscale_out main(v2p_upscale I)
{
	int3 px = int3(I.HPos.xy, 0);
	upscale_out o;
	o.mv = -s_upscale_mv_in.Load(px).xy * upscale_params.xy;
	float2 rim_mv;
	bool lens = s_upscale_lens.Load(px).r > 0.5f;
	if (lens)
		o.mv = lens_rim_mv(I.HPos.xy, rim_mv) ? -rim_mv * upscale_params.xy : 0.0f; // zero: no tube found, fixed in the sight
	// NaN / inf / huge vectors (sky, first frame, garbage) would spread over the whole DLSS frame
	// (exponent bits test: isnan/isinf may be optimised away without IEEE strictness)
	o.mv = any((asuint(o.mv) & 0x7f800000) == 0x7f800000) ? 0.0f : clamp(o.mv, -upscale_params.xy, upscale_params.xy);
	float z = s_upscale_pos_in.Load(px).z;
	o.depth = (z > 0.0001f && (asuint(z) & 0x7f800000) != 0x7f800000) ? saturate(upscale_params.z + upscale_params.w / z) : 1.0f;
	return o;
}
