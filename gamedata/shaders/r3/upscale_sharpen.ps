// Engine: CRenderTarget::phase_sharpen, output size, input = LDR scene image in 0..1 (RCAS limits assume that range)
uniform float4 rcas_con; // x: lobe scale = 2^-stops (FSR: stops = 2 - 2 * sharpness)

Texture2D s_sharpen_src;

#define FSR_RCAS_LIMIT (0.25 - (1.0 / 16.0))

struct v2p_sharpen
{
	float2 Tex0 : TEXCOORD0;
	float4 Color : COLOR;
	float4 HPos : SV_Position;
};

float min3(float a, float b, float c) { return min(min(a, b), c); }
float max3(float a, float b, float c) { return max(max(a, b), c); }

float4 main(v2p_sharpen I) : SV_Target
{
	//    b
	//  d e f
	//    h
	int3 sp = int3(I.HPos.xy, 0);
	float3 b = s_sharpen_src.Load(sp, int2(0, -1)).rgb;
	float3 d = s_sharpen_src.Load(sp, int2(-1, 0)).rgb;
	float4 ee = s_sharpen_src.Load(sp);
	float3 e = ee.rgb;
	float3 f = s_sharpen_src.Load(sp, int2(1, 0)).rgb;
	float3 h = s_sharpen_src.Load(sp, int2(0, 1)).rgb;

	// Luma times 2
	float bL = b.b * 0.5 + (b.r * 0.5 + b.g);
	float dL = d.b * 0.5 + (d.r * 0.5 + d.g);
	float eL = e.b * 0.5 + (e.r * 0.5 + e.g);
	float fL = f.b * 0.5 + (f.r * 0.5 + f.g);
	float hL = h.b * 0.5 + (h.r * 0.5 + h.g);

	// Min and max of ring
	float3 mn4 = min(min(min(b, d), f), h);
	float3 mx4 = max(max(max(b, d), f), h);

	// Immediate constants for peak range
	float2 peakC = float2(1.0, -1.0 * 4.0);

	// Limiters, these need to be high precision RCPs
	float lowerLimiterMultiplier = saturate(eL / min(min3(bL, dL, fL), hL));
	float3 hitMin = mn4 * rcp(4.0 * mx4) * lowerLimiterMultiplier;
	float3 hitMax = (peakC.x - mx4) * rcp(4.0 * mn4 + peakC.y);
	float3 lobeRGB = max(-hitMin, hitMax);
	float lobe = max(-FSR_RCAS_LIMIT, min(max3(lobeRGB.r, lobeRGB.g, lobeRGB.b), 0.0)) * rcas_con.x;

	// Resolve
	float rcpL = rcp(4.0 * lobe + 1.0);
	float3 pix = (lobe * b + lobe * d + lobe * h + lobe * f + e) * rcpL;
	return float4(pix, ee.a);
}
