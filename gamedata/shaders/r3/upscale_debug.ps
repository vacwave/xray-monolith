#include "common.h"

// r4_upscale_debug view at output size (engine: CRenderTarget::phase_upscale_debug)
uniform float4 upscale_params; // xy: render size, z: projection _33, w: projection _43
uniform float4 upscale_debug; // x: 1 motion vectors, 2 depth

Texture2D s_upscale_mv;
Texture2D s_upscale_depth;

struct v2p_upscale
{
	float2 Tex0 : TEXCOORD0;
	float4 Color : COLOR;
	float4 HPos : SV_Position;
};

float4 main(v2p_upscale I) : SV_Target
{
	int3 px = int3(I.HPos.xy * screen_res.zw * upscale_params.xy, 0);

	if (upscale_debug.x < 1.5f)
	{
		// Grey = no motion; red/green above or below grey = motion along x/y, 8 px reaches 0.75 / 0.25
		float2 mv = s_upscale_mv.Load(px).xy;
		return float4(0.5f + 0.5f * mv / (abs(mv) + 8.0f), 0.5f, 1.0f);
	}

	// Depth back to view distance: black near, 0.5 at 20 m, white at the far plane / sky
	float d = s_upscale_depth.Load(px).x;
	float z = upscale_params.w / min(d - upscale_params.z, -1e-6f);
	float v = d >= 1.0f ? 1.0f : z / (z + 20.0f);
	return float4(v, v, v, 1.0f);
}
