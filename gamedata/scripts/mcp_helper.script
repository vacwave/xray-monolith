-- MCP helper: runs Lua chunks sent by the MCP bridge and serializes the results.
-- The engine (C++) calls mcp_helper.eval(code) on the main thread and returns the string verbatim.
-- Reply is "+<values, one per line>" on success or "-<message>" on error.

local MAX_DEPTH, MAX_ENTRIES, MAX_BYTES = 3, 200, 65536

local fmt

local function key_less(a, b)
	local ta, tb = type(a), type(b)
	if ta == "number" and tb == "number" then return a < b end
	if ta == "number" then return true end
	if tb == "number" then return false end
	if ta == "string" and tb == "string" then return a < b end
	return tostring(a) < tostring(b)
end

local function userdata_str(v)
	local ok, x = pcall(function() return v.x end)
	if ok and type(x) == "number" then
		return string.format("vector{x = %s, y = %s, z = %s}", tostring(x), tostring(v.y), tostring(v.z))
	end
	local parts = {tostring(v)}
	for _, f in ipairs({"name", "id", "section"}) do
		local ok2, fn = pcall(function() return v[f] end)
		if ok2 and fn ~= nil then
			local ok3, r = pcall(fn, v)
			if ok3 and r ~= nil then parts[#parts + 1] = f .. "=" .. tostring(r) end
		end
	end
	return table.concat(parts, " ")
end

local function table_str(t, depth, seen, ctx)
	if seen[t] then return "<cycle>" end
	if depth > MAX_DEPTH then return "{...}" end
	seen[t] = true
	local keys, n = {}, 0
	for k in pairs(t) do n = n + 1; keys[n] = k end
	table.sort(keys, key_less)
	local out = {}
	for i = 1, math.min(n, MAX_ENTRIES) do
		if ctx.bytes > MAX_BYTES then break end
		local k = keys[i]
		local ks = type(k) == "string" and (k:match("^[%a_][%w_]*$") and k or "[" .. string.format("%q", k) .. "]") or ("[" .. tostring(k) .. "]")
		local s = ks .. " = " .. fmt(t[k], depth + 1, seen, ctx, true)
		ctx.bytes = ctx.bytes + #s
		out[#out + 1] = s
	end
	if n > MAX_ENTRIES then out[#out + 1] = "...(+" .. (n - MAX_ENTRIES) .. " more)" end
	seen[t] = nil
	return "{" .. table.concat(out, ", ") .. "}"
end

fmt = function(v, depth, seen, ctx, quote)
	local ok, s = pcall(function()
		local tv = type(v)
		if tv == "string" then return quote and string.format("%q", v) or v end
		if tv == "table" then return table_str(v, depth, seen, ctx) end
		if tv == "userdata" then return userdata_str(v) end
		return tostring(v)
	end)
	return ok and s or ("<error: " .. tostring(s) .. ">")
end

function serialize(...)
	local ctx, lines = {bytes = 0}, {}
	for i = 1, select("#", ...) do
		local s = fmt((select(i, ...)), 1, {}, ctx, false)
		ctx.bytes = ctx.bytes + #s
		lines[i] = s
	end
	local res = table.concat(lines, "\n")
	if #res > MAX_BYTES then res = res:sub(1, MAX_BYTES) .. "...(truncated)" end
	return res
end

local function pack_ok(ok, ...)
	if not ok then return false, (...) end
	return true, "+" .. serialize(...)
end

function eval(code)
	local fn, err = loadstring(code, "=mcp")
	if not fn then return "-" .. tostring(err) end
	local ok, res = pack_ok(xpcall(fn, function(e)
		printf("[mcp] %s", debug.traceback(tostring(e), 2))
		return e
	end))
	if ok then return res end
	return "-" .. tostring(res)
end

-- Helpers the bridge calls through eval (e.g. "return mcp_helper.teleport(x, y, z)").
-- Each returns a string and never throws: failures come back as "error: <message>".

local INVALID_LVID = 4294967295 -- u32(-1) from level.vertex_id when no AI node is under the point

local function try(f, ...)
	local ok, res = pcall(f, ...)
	if ok then return res end
	return "error: " .. tostring(res)
end

-- What F2 in the main menu does: new game on the debug test map (level fake_start).
function start_test_map()
	return try(function()
		exec_console_cmd("keypress_on_start off")
		local cfg = axr_main.config
		cfg:w_value("character_creation", "new_game_test", true)
		cfg:w_value("character_creation", "new_game_difficulty", 1)
		cfg:w_value("character_creation", "new_game_economy", 1)
		cfg:w_value("character_creation", "new_game_faction", "stalker")
		cfg:w_value("character_creation", "new_game_loadout", "device_pda_1")
		cfg:save()
		if alife() ~= nil then exec_console_cmd("disconnect") end
		device():pause(false)
		exec_console_cmd("start server(all/single/alife/new) client(localhost)")
		exec_console_cmd("main_menu off")
		return "started"
	end)
end

-- Same-level teleport, snapped to the AI node under (x, z). Returns "x y z level_name".
function teleport(x, y, z)
	return try(function()
		if not db.actor then return "error: no actor (not in a level)" end
		local lvid = level.vertex_id(vector():set(x, y, z))
		if lvid == INVALID_LVID then
			return string.format("error: no AI node near %s,%s,%s on level %s", tostring(x), tostring(y), tostring(z), level.name())
		end
		local p = level.vertex_position(lvid)
		db.actor:set_actor_position(p)
		return string.format("%.2f %.2f %.2f %s", p.x, p.y, p.z, level.name())
	end)
end

-- Cross-level part of a teleport, like _g.JumpToLevel but without the fade animation.
-- Returns "changing" (the level change is already under way) or error text.
function jump_to_level(name)
	return try(function()
		if not db.actor then return "error: no actor (not in a level)" end
		if level.name() == name then return "error: already on level " .. name end
		local sim, gg = alife(), game_graph()
		local function go(cvertex, gvid)
			ChangeLevel(cvertex:level_point(), cvertex:level_vertex_id(), gvid, VEC_ZERO, false)
			return "changing"
		end
		-- smart terrains first, like JumpToLevel
		for _, smart in pairs(db.smart_terrain_by_id) do
			local cvertex = smart and gg:vertex(smart.m_game_vertex_id)
			if cvertex and sim:level_name(cvertex:level_id()) == name then
				return go(cvertex, smart.m_game_vertex_id)
			end
		end
		-- then the first game vertex on that level; collect the known names for the error
		local known, seen = {}, {}
		for gvid = 0, 4860 do
			if not gg:valid_vertex_id(gvid) then break end
			local cvertex = gg:vertex(gvid)
			local lvl = sim:level_name(cvertex:level_id())
			if lvl == name then return go(cvertex, gvid) end
			if lvl and not seen[lvl] then
				seen[lvl] = true
				known[#known + 1] = lvl
			end
		end
		table.sort(known)
		return "error: unknown level " .. tostring(name) .. "; known levels: " .. table.concat(known, ", ")
	end)
end

-- Uncompressed DDS; relpath is resolved against $game_textures$, w/h are clamped to the window.
function screenshot(relpath, w, h)
	return try(function()
		level.take_screenshot(relpath, vector2():set(w, h), 0)
		return "ok"
	end)
end

-- Actor state and item spawning (main thread, through eval).
local INV_MAX_LINES = 100 -- inventory sections listed by actor_state
local GIVE_MAX = 50

local function num(v)
	return v and string.format("%.2f", v) or "?"
end

-- weapons, outfits and helmets wear too, though only some sections set use_condition
local function has_cond(item, sec)
	return IsWeapon(item) or IsOutfit(item) or IsHeadgear(item) or utils_item.is_degradable(item, sec)
end

local function item_desc(item)
	if not item then return "none" end
	local sec = item:section()
	local ok, cond = pcall(function() return has_cond(item, sec) and item:condition() end)
	if ok and cond then return string.format("%s (cond %.2f)", sec, cond) end
	return sec
end

-- One multi-line text: level, position, vitals, money, equipment, inventory grouped by section.
function actor_state()
	return try(function()
		local a = db.actor
		if not a then return "error: no actor (not in a level)" end
		local p, out = a:position(), {}
		out[#out + 1] = string.format("level %s  pos %.2f %.2f %.2f  yaw %.1f", level.name(), p.x, p.y, p.z, math.deg(-device().cam_dir:getH()) % 360)
		out[#out + 1] = string.format("alive %s  health %s  psy_health %s  radiation %s  bleeding %s",
			tostring(a:alive()), num(a.health), num(a.psy_health), num(a.radiation), num(a.bleeding))
		local function opt(f)
			local ok, v = pcall(f)
			return ok and v or nil
		end
		out[#out + 1] = string.format("satiety %s  thirst %s  sleep_deprivation %s  money %d  weight %s",
			num(opt(function() return a:cast_Actor():conditions():GetSatiety() end)),
			num(opt(function() return actor_status_thirst.get_water_deprivation() end)),
			num(opt(function() return actor_status_sleep.get_sleep_deprivation() end)),
			a:money(), num(opt(function() return a:get_total_weight() end)))
		local slot = a:active_slot()
		local active = a:active_item()
		local mag = active and opt(function() return IsWeapon(active) and active:get_ammo_in_magazine() end)
		out[#out + 1] = string.format("active slot %d: %s%s", slot, item_desc(active), mag and (" mag " .. mag) or "")
		out[#out + 1] = string.format("outfit %s  helmet %s", item_desc(a:item_in_slot(7)), item_desc(a:item_in_slot(12)))
		-- inventory grouped by section
		local groups, order = {}, {}
		a:iterate_inventory(function(_, item)
			local sec = item:section()
			local g = groups[sec]
			if not g then
				g = {n = 0}
				groups[sec] = g
				order[#order + 1] = sec
			end
			g.n = g.n + 1
			if IsAmmo(item) then
				g.rounds = (g.rounds or 0) + item:ammo_get_count()
			elseif IsItem("multiuse", sec) then
				g.uses = (g.uses or 0) + (item:get_remaining_uses() or 0)
			elseif has_cond(item, sec) then
				local c = item:condition()
				g.lo = math.min(g.lo or c, c)
				g.hi = math.max(g.hi or c, c)
			end
		end, a)
		table.sort(order)
		out[#out + 1] = string.format("inventory: %d sections", #order)
		for i, sec in ipairs(order) do
			if i > INV_MAX_LINES then
				out[#out + 1] = string.format("  ...(+%d more sections)", #order - INV_MAX_LINES)
				break
			end
			local g, extra = groups[sec], ""
			if g.rounds then
				extra = string.format(" (%d rounds)", g.rounds)
			elseif g.uses then
				extra = string.format(" (%d uses)", g.uses)
			elseif g.lo then
				extra = g.lo == g.hi and string.format(" (cond %.2f)", g.lo) or string.format(" (cond %.2f-%.2f)", g.lo, g.hi)
			end
			out[#out + 1] = string.format("  %s x%d%s", sec, g.n, extra)
		end
		return table.concat(out, "\n")
	end)
end

-- Spawn `count` items of `section` into the actor's inventory (ammo: `count` full boxes).
-- The server objects exist at once; the items show up in the inventory a few frames later.
function give_item(section, count)
	return try(function()
		if not db.actor then return "error: no actor (not in a level)" end
		section = tostring(section)
		if not ini_sys:section_exist(section) then return "error: unknown section " .. section end
		if not ini_sys:line_exist(section, "inv_weight") then return "error: " .. section .. " is not an inventory item" end
		count = math.floor(tonumber(count) or 1)
		if count < 1 or count > GIVE_MAX then return string.format("error: count must be 1..%d", GIVE_MAX) end
		local ids = {}
		for _ = 1, count do
			local se = alife_create_item(section, db.actor)
			if not se then break end
			ids[#ids + 1] = se.id
		end
		if #ids == 0 then return "error: alife_create_item failed for " .. section .. " (see log)" end
		return string.format("created %dx %s (ids %s)", #ids, section, table.concat(ids, ", "))
	end)
end

-- Game input. level.press_action/hold_action/release_action take a DIK key code, so an action
-- name ("kINVENTORY", "INVENTORY") goes through its current binding; "DIK_W" style key names and
-- raw key codes are passed as they are.
local holds = {} -- dik -> frames left to hold; released by on_actor_update

local function to_dik(name)
	if type(name) == "number" then return name end
	local s = tostring(name)
	if s:sub(1, 4) == "DIK_" then
		local ok, dik = pcall(function() return DIK_keys[s] end)
		if ok and type(dik) == "number" then return dik end
		return nil, "unknown key " .. s
	end
	for _, candidate in ipairs({s, "k" .. s, "k" .. s:upper()}) do
		local ok, action = pcall(function() return key_bindings[candidate] end)
		if ok and type(action) == "number" then
			local dik = bind_to_dik(action)
			if not dik or dik == 0 then return nil, "action " .. candidate .. " has no key bound" end
			return dik
		end
	end
	return nil, "unknown action " .. s .. " (key_bindings name like kINVENTORY, or DIK_ key name)"
end

local function on_actor_update()
	for dik, left in pairs(holds) do
		level.hold_action(dik)
		if left <= 1 then
			holds[dik] = nil
			level.release_action(dik)
		else
			holds[dik] = left - 1
		end
	end
end

-- Called by axr_main on game start (main thread), like every script that defines on_game_start.
function on_game_start()
	RegisterScriptCallback("actor_on_update", on_actor_update)
end

-- mode: "press", "release", "tap" (press now, hold one actor update, release) or
-- "hold" (press now, hold for `frames` actor updates, release). Returns "<mode> <name> dik=<n>".
function input(name, mode, frames)
	return try(function()
		if not level.present() then return "error: no level loaded" end
		local dik, err = to_dik(name)
		if not dik then return "error: " .. err end
		mode = mode or "tap"
		if mode == "press" then
			level.press_action(dik)
		elseif mode == "release" then
			holds[dik] = nil
			level.release_action(dik)
		elseif mode == "tap" or mode == "hold" then
			level.press_action(dik)
			local n = mode == "tap" and 1 or math.max(1, math.floor(tonumber(frames) or 60))
			if db.actor then
				holds[dik] = n
			else
				level.release_action(dik) -- no actor updates to release it later
			end
		else
			return "error: unknown mode " .. tostring(mode) .. " (press, release, tap, hold)"
		end
		return string.format("%s %s dik=%d", mode, tostring(name), dik)
	end)
end
